---
import Base from '../../layouts/Base.astro';
import { posts } from '../../data/posts';
import { OPERATOR_NAME, OWNER_ROLE, abs } from '../../config';
export function getStaticPaths() { return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } })); }
const { post } = Astro.props;
const path = `/blog/${post.slug}/`;
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') }, { '@type': 'ListItem', position: 2, name: 'Blog', item: abs('/blog/') }, { '@type': 'ListItem', position: 3, name: post.title, item: abs(path) }] },
  { '@context': 'https://schema.org', '@type': 'Article', headline: post.title, description: post.description, datePublished: post.date, dateModified: post.date, author: { '@type': 'Person', name: OPERATOR_NAME, jobTitle: OWNER_ROLE }, mainEntityOfPage: abs(path) },
];
---
<Base title={`${post.title} | ImageTo20KB`} description={post.description} path={path} jsonld={jsonld} crumbs={[{ name: 'Blog', href: '/blog/' }, { name: post.title, href: path }]}>
  <div class="wrap"><article class="prose">
    <h1>{post.title}</h1>
    <p class="note">By {OPERATOR_NAME}, {OWNER_ROLE} · Published {post.date}</p>
    <p class="lead">{post.description}</p>
    {post.sections.map((s) => <><h2>{s.h2}</h2>{s.body.map((b) => <p>{b}</p>)}</>)}
    <h2>Try the tools mentioned</h2>
    <ul class="links">{post.links.map(([n, h]) => <li><a href={h}>{n}</a></li>)}</ul>
    <p class="note">Size limits differ by exam and by year. Always follow the instructions on the official application portal. ImageTo20KB is not affiliated with any exam body or employer. <a href="/blog/">More posts</a> · <a href="/about/">About the author</a></p>
  </article></div>
</Base>
