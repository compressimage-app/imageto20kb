---
import Answer from '../components/Answer.astro';
import { answers } from '../data/answers';
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, CONTACT_FORM_ENDPOINT, OPERATOR_NAME, OWNER_ROLE } from '../config';
import { TOPICS, LIMITS } from '../lib/contact';
const mail = `mailto:${CONTACT_EMAIL}`;
---
<Base title="Contact ImageTo20KB: Support, Feedback and Reports" description="Contact ImageTo20KB for tool problems, exam size questions, feedback, accessibility, copyright or security reports. Use the contact form or email us." path="/contact/" crumbs={[{ name: 'Contact', href: '/contact/' }]}>
  <div class="wrap"><article class="prose">
    <h1>Contact ImageTo20KB</h1>
    <Answer text={answers['contact']} />
    <p class="lead">Have a question about compressing a photo or signature, found a mistake in a guide, or need to report a problem? Use the form below or email us directly. This page also explains what to include so that we can help you quickly.</p>

    <section class="panel" id="contact-form-panel" aria-labelledby="cf-h" data-email={CONTACT_EMAIL} data-endpoint={CONTACT_FORM_ENDPOINT}>
      <h2 id="cf-h" style="margin-top:0">Send us a message</h2>
      <form id="contact-form" novalidate>
        <div class="field"><label for="cf-name">Your name</label><input id="cf-name" name="name" type="text" autocomplete="name" maxlength={LIMITS.nameMax} required aria-describedby="cf-name-err" /><p class="ferr" id="cf-name-err" role="alert"></p></div>
        <div class="field"><label for="cf-email">Your email address</label><input id="cf-email" name="email" type="email" autocomplete="email" required aria-describedby="cf-email-err" /><p class="ferr" id="cf-email-err" role="alert"></p></div>
        <div class="field"><label for="cf-topic">Topic</label>
          <select id="cf-topic" name="topic" required aria-describedby="cf-topic-err"><option value="">Choose a topic…</option>{TOPICS.map((t) => <option value={t}>{t}</option>)}</select><p class="ferr" id="cf-topic-err" role="alert"></p></div>
        <div class="field"><label for="cf-message">Message</label><textarea id="cf-message" name="message" rows="7" maxlength={LIMITS.msgMax} required aria-describedby="cf-message-hint cf-message-err"></textarea>
          <p class="note" id="cf-message-hint">Tell us the page address, your browser and device, and what happened. Maximum {LIMITS.msgMax} characters. Please do not include ID numbers or private documents.</p><p class="ferr" id="cf-message-err" role="alert"></p></div>
        <div class="hp" aria-hidden="true"><label for="cf-website">Leave this field empty</label><input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
        <div class="row"><button class="btn" type="submit" id="cf-submit">Send message</button><a class="btn alt" href={mail}>Or email us directly</a></div>
        <p id="cf-status" class="note" role="status" aria-live="polite"></p>
      </form>
      <p class="note">This form opens your own email application with the message ready to send, so nothing is sent until you press send there. If nothing opens, copy your message and email it to us at the address on this page.</p>
    </section>

    <h2>Ways to contact us</h2>
    <p>The simplest way is the form above, which prepares an email for you. You can also write directly to <a href={mail}>{CONTACT_EMAIL}</a>. The site has no accounts, no chat widget and no telephone line, which keeps things simple and means there is no profile of you on this site to manage.</p>

    <h2>Which topic should I choose?</h2>
    <p><strong>Problem with the tool</strong> is for cases where a file would not load, compression failed, the result was unexpectedly large, or a button did not work. <strong>Exam photo or signature size question</strong> is for the exam pages: if you think a size range is out of date or wrong, tell us which exam, which notification and where you saw the correct figure. <strong>Correction or feedback on a guide</strong> covers the blog and help pages. <strong>Accessibility barrier</strong> is for anything that is hard to use with a keyboard, screen reader or zoom. <strong>Copyright notice</strong> and <strong>Security report</strong> are explained further below. <strong>Something else</strong> is for any other question.</p>

    <h2>Troubleshooting local client issues before writing</h2>
    <p>Before submitting a technical bug report regarding compression failure or unexpected file sizes, please consider these quick troubleshooting steps that resolve over 90% of local browser anomalies:</p>
    <ul class="facts">
      <li><strong>Clear Browser Cache & Local Storage:</strong> Outdated cached service workers or scripts can occasionally cause interface stalls. A hard reload (Ctrl+F5 or Cmd+Shift+R) updates the client bundle immediately.</li>
      <li><strong>Disable Memory-Intensive Browser Extensions:</strong> Third-party ad blockers, web scrapers, or script injectors can occasionally intercept canvas data exports or block blob downloads. Testing in an incognito or private window confirms whether an extension is interfering.</li>
      <li><strong>Verify Original File Dimensions:</strong> Attempting to process raw camera files exceeding 50 megapixels on budget smartphones may cause memory allocation crashes. If a file fails to load, resize it moderately in your phone's native gallery editor first.</li>
      <li><strong>Check File Extension Authenticity:</strong> If your photo was exported from an iPhone in HEIC format and renamed to ".jpg", the browser's Canvas API cannot decode it. Ensure the file is an authentic standard JPEG, PNG, or WebP.</li>
    </ul>

    <h2>Guidelines for reporting government exam portal discrepancies</h2>
    <p>Exam conducting bodies (including SSC, UPSC, RRB, state public service commissions, and banking institutes) periodically alter their digital application guidelines between recruitment cycles. If you notice a discrepancy between our published exam guides and your active notification, please share:</p>
    <ul class="facts">
      <li>The exact exam notification reference number and publishing year (e.g., SSC CGL 2026 Notification, Advt No. 04/2026).</li>
      <li>The specific clause or page number in the official PDF specifying photo or signature dimensions, accepted formats, and kilobyte boundaries.</li>
      <li>Whether the portal utilizes live webcam photo capture or static file upload for the current cycle.</li>
    </ul>
    <p>We review official source PDFs promptly and update our dedicated exam presets to keep all candidates accurately prepared.</p>

    <h2>What to include in a technical support message</h2>
    <p>A detailed message allows us to reproduce and resolve bugs quickly without unnecessary back-and-forth communication. When reporting a malfunction, please provide:</p>
    <ul class="facts">
      <li>The exact web address (URL) of the page where the issue occurred.</li>
      <li>Your operating system (e.g., Windows 11, macOS Sequoia, Android 15, iOS 18) and browser version (e.g., Chrome 130, Safari 18, Firefox 132).</li>
      <li>The input file format, file size, and approximate resolution (e.g., 3.2 MB JPEG, 4000×3000 pixels).</li>
      <li>The specific target kilobyte setting you selected and any advanced settings enabled (such as "Keep dimensions" or custom quality).</li>
      <li>The exact error message or visual behavior observed. Please never attach personal identity documents, Aadhaar cards, PAN scans, or sensitive biometric files to your email.</li>
    </ul>

    <h2>Institutional inquiries, educational usage and non-profit access</h2>
    <p>ImageTo20KB is proudly free to use for individual students, job applicants, educators, and community cyber centers. If you operate an educational institution, community computer lab, or recruitment training center, you are completely free to bookmark, recommend, and incorporate ImageTo20KB into your student preparation curricula without paying licensing fees or requesting prior written permission.</p>
    <p>If your organization requires custom integration guidance, batch processing advice, or technical consultation regarding privacy-first client-side image processing, please select "Something else" in the contact form or email our software engineering team directly.</p>

    <h2>Security vulnerability disclosure policy</h2>
    <p>We take user data security and client-side application integrity seriously. While ImageTo20KB does not maintain user account databases or server-side image pipelines, our client-side implementation must remain robust against Cross-Site Scripting (XSS), Content Security Policy (CSP) bypasses, and denial-of-service vectors.</p>
    <p>If you identify a potential security vulnerability, please submit your findings to {CONTACT_EMAIL} with the subject line "SECURITY DISCLOSURE". Please include reproducible steps, HTTP request/response payloads if applicable, and allow reasonable time for remediation prior to public disclosure. We acknowledge valid responsible disclosures promptly.</p>

    <h2>What we can and cannot help with</h2>
    <p>We can explain how our compression algorithm behaves, suggest optimal configuration settings for difficult images, correct outdated exam guidelines, and resolve platform bugs. We cannot guarantee that an external portal will accept a file, as external government and corporate portals maintain proprietary validation logic beyond our control.</p>
    <p>We cannot retrieve original files that were deleted from your personal device, as no files are stored on our servers. If an official recruitment portal repeatedly rejects your submission due to server errors or portal downtime, please reach out directly to the official recruitment helpdesk listed in your exam notification.</p>

    <h2>Quick answers before you write</h2>
    <p>Many common inquiries are answered in depth across our resource center: our <a href="/faqs/">FAQs page</a> covers image formats and privacy; our <a href="/blog/photo-rejected-file-size-too-large-after-compression/">upload troubleshooting guide</a> explains why portals reject files even after compression; and our <a href="/how-it-works/">technical architecture guide</a> explains our bounded binary search engine in detail.</p>

    <h2>Privacy and data retention of support communications</h2>
    <p>When you submit a message using the form, your native email client prepares the dispatch. The communication travels directly through standard email protocols to our secure inbox. We collect only your name, email address, and message text to respond to your inquiry and preserve conversation records for technical debugging. We never sell, rent, or distribute support inquiries. For complete information, see our <a href="/privacy-policy/">privacy policy</a>.</p>

    <h2>Who replies</h2>
    <p>Technical support, editorial reviews, and software maintenance are managed directly by {OPERATOR_NAME}, {OWNER_ROLE}. Inquiries are reviewed chronologically during regular working hours. Learn more on our <a href="/about/">about page</a>.</p>
  </article></div>
  <script>
    import { validateContact, buildMailto, type ContactInput } from '../lib/contact';
    const panel = document.getElementById('contact-form-panel')!;
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('cf-status')!;
    const to = panel.dataset.email || '', endpoint = panel.dataset.endpoint || '';
    const ids = ['name', 'email', 'topic', 'message'] as const;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const input: ContactInput = { name: String(f.get('name') || ''), email: String(f.get('email') || ''), topic: String(f.get('topic') || ''), message: String(f.get('message') || ''), website: String(f.get('website') || '') };
      const res = validateContact(input);
      ids.forEach((k) => {
        const el = document.getElementById('cf-' + k) as HTMLElement, err = document.getElementById(`cf-${k}-err`)!;
        err.textContent = res.errors[k] || ''; el.setAttribute('aria-invalid', res.errors[k] ? 'true' : 'false');
      });
      if (res.spam) { status.textContent = 'Your message could not be sent.'; return; }
      if (!res.ok) { status.textContent = 'Please fix the highlighted fields.'; (form.querySelector('[aria-invalid="true"]') as HTMLElement | null)?.focus(); return; }
      if (endpoint) {
        status.textContent = 'Sending…';
        try {
          const r = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ name: input.name, email: input.email, topic: input.topic, message: input.message }) });
          if (!r.ok) throw new Error('bad status');
          status.textContent = 'Thank you. Your message was sent.'; form.reset();
        } catch { status.textContent = `Sorry, the message could not be sent. Please email ${to} instead.`; }
        return;
      }
      window.location.href = buildMailto(to, input);
      status.textContent = `Your email app should open with the message ready. If it does not, please email ${to} directly.`;
    });
  </script>
</Base>
