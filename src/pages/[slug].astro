---
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { landing } from '../data/landing';
import { legal } from '../data/legal';
import { more } from '../data/landing-more';
import { more2 } from '../data/landing-more2';
import { more3 } from '../data/landing-more3';
import { seoMore } from '../data/landing-seo';
import { SITE_NAME, LAST_UPDATED, abs } from '../config';
export function getStaticPaths() {
  return [
    ...landing.map((p) => ({ params: { slug: p.slug }, props: { kind: 'tool', slug: p.slug } })),
    ...legal.map((p) => ({ params: { slug: p.slug }, props: { kind: 'legal', slug: p.slug } })),
  ];
}
const { kind, slug } = Astro.props;
const page = kind === 'tool' ? landing.find((p) => p.slug === slug)! : null;
const doc = kind === 'legal' ? legal.find((p) => p.slug === slug)! : null;
const path = `/${slug}/`;
const guides: Record<string, [string, string]> = {
  'compress-image-to-20kb': ['How to compress image to 20KB: a step-by-step guide', '/blog/how-to-compress-image-to-20kb/'],
  'compress-jpg-to-20kb': ['How to compress image to 20KB: a step-by-step guide', '/blog/how-to-compress-image-to-20kb/'],
  'compress-image-to-100kb': ['How to compress image to 100KB online (without losing clarity)', '/blog/how-to-compress-image-to-100kb/'],
  'compress-jpg-to-100kb': ['How to compress image to 100KB online (without losing clarity)', '/blog/how-to-compress-image-to-100kb/'],
};
const guide = page ? guides[page.slug] : undefined;
const title = (page ?? doc)!.title, description = (page ?? doc)!.description, h1 = (page ?? doc)!.h1;
const crumbs = [{ name: h1, href: path }];
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') }, { '@type': 'ListItem', position: 2, name: h1, item: abs(path) }] },
  ...(page ? [{ '@context': 'https://schema.org', '@type': 'WebApplication', name: `${SITE_NAME}: ${h1}`, url: abs(path), applicationCategory: 'MultimediaApplication', operatingSystem: 'Any (modern web browser)', description }] : []),
];
---
<Base {title} {description} {path} {jsonld} {crumbs}>
  {page && (<>
    <section class="hero" style="padding-bottom:0"><div class="wrap"><h1>{page.h1}</h1><p class="lead">{page.intro}</p>{page.updated && <p class="note">Size ranges last reviewed: {page.updated}. Always confirm against your exam notification.</p>}</div></section>
    <div class="wrap">
      <Tool target={page.target} format={page.format} advanced={page.advanced} examPresets={page.examPresets} />
      <BeforeAfter target={page.target} />
      <article class="prose">
        {[...page.sections, ...(more[page.slug] ?? []), ...(more2[page.slug] ?? []), ...(more3[page.slug] ?? []), ...(seoMore[page.slug] ?? [])].map((s) => <><h2>{s.h2}</h2>{s.body.map((b) => <p>{b}</p>)}</>)}
        <h2>Common questions</h2>
        {page.faqs.map((f) => <details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}
        <p>More answers on the <a href="/faqs/">FAQs page</a>.{guide && <> Read the guide: <a href={guide[1]}>{guide[0]}</a>.</>}</p>
        <h2>Related tools</h2>
        <RelatedLinks slugs={page.related} />
      </article>
    </div>
  </>)}
  {doc && (
    <div class="wrap"><article class="prose">
      <h1>{doc.h1}</h1><p class="muted">Last updated: {LAST_UPDATED}</p>
      {doc.slug === 'cookie-policy' && (
        <section class="panel" id="choices" aria-labelledby="choice-h">
          <h2 id="choice-h" style="margin-top:0">Your cookie choice</h2>
          <p id="consent-status" role="status" aria-live="polite">You have not made a choice yet</p>
          <p class="note">Analytics cookies are only set if you accept. You can change your mind at any time; rejecting also removes the analytics cookies this site set in your browser.</p>
          <div class="row"><button class="btn" type="button" data-consent="granted">Accept analytics</button><button class="btn alt" type="button" data-consent="denied">Reject analytics</button></div>
        </section>
      )}
      {doc.sections.map((s) => <><h2>{s.h2}</h2>{s.body.map((b) => <p>{b}</p>)}</>)}
      <p><a href="/contact/">Contact us</a> · <a href="/">Back to the image compressor</a></p>
    </article></div>
  )}
</Base>
