---
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { landing } from '../data/landing';
import { legal } from '../data/legal';
import { more } from '../data/landing-more';
import { more2 } from '../data/landing-more2';
import { more3 } from '../data/landing-more3';
import { SITE_NAME, LAST_UPDATED, abs } from '../config';
export function getStaticPaths() {
  return [
    ...landing.map((p) => ({ params: { slug: p.slug }, props: { kind: 'tool', slug: p.slug } })),
    ...legal.map((p) => ({ params: { slug: p.slug }, props: { kind: 'legal', slug: p.slug } })),
  ];
}
const { kind, slug } = Astro.props;
const page = kind === 'tool' ? landing.find((p) => p.slug === slug)! : null;
const doc = kind === 'legal' ? legal.find((p) => p.slug === slug)! : null;
const path = `/${slug}/`;
const title = (page ?? doc)!.title, description = (page ?? doc)!.description, h1 = (page ?? doc)!.h1;
const crumbs = [{ name: h1, href: path }];
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') }, { '@type': 'ListItem', position: 2, name: h1, item: abs(path) }] },
  ...(page ? [{ '@context': 'https://schema.org', '@type': 'WebApplication', name: `${SITE_NAME}: ${h1}`, url: abs(path), applicationCategory: 'MultimediaApplication', operatingSystem: 'Any (modern web browser)', description }] : []),
];
---
<Base {title} {description} {path} {jsonld} {crumbs}>
  {page && (<>
    <section class="hero" style="padding-bottom:0"><div class="wrap"><h1>{page.h1}</h1><p class="lead">{page.intro}</p>{page.updated && <p class="note">Size ranges last reviewed: {page.updated}. Always confirm against your exam notification.</p>}</div></section>
    <div class="wrap">
      <Tool target={page.target} format={page.format} advanced={page.advanced} examPresets={page.examPresets} />
      <article class="prose">
        {[...page.sections, ...(more[page.slug] ?? []), ...(more2[page.slug] ?? []), ...(more3[page.slug] ?? [])].map((s) => <><h2>{s.h2}</h2>{s.body.map((b) => <p>{b}</p>)}</>)}
        <h2>Common questions</h2>
        {page.faqs.map((f) => <details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}
        <p>More answers on the <a href="/faqs/">FAQs page</a>.</p>
        <h2>Related tools</h2>
        <RelatedLinks slugs={page.related} />
      </article>
    </div>
  </>)}
  {doc && (
    <div class="wrap"><article class="prose">
      <h1>{doc.h1}</h1><p class="muted">Last updated: {LAST_UPDATED}</p>
      {doc.sections.map((s) => <><h2>{s.h2}</h2>{s.body.map((b) => <p>{b}</p>)}</>)}
      <p><a href="/contact/">Contact us</a> · <a href="/">Back to the image compressor</a></p>
    </article></div>
  )}
</Base>
