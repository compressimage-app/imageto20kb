---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { SITE_NAME, GA_ID, BING_VALIDATION } from '../config';
import { toolGroups, toolPaths, footer } from '../data/nav';
interface Props { title: string; description: string; path: string; noindex?: boolean; jsonld?: object[]; crumbs?: { name: string; href: string }[] }
const { crumbs, ...seo } = Astro.props;
const here = Astro.url.pathname;
const top = [['Home', '/'], ['About', '/about/'], ['Contact', '/contact/']];
const top2 = [['Blog', '/blog/'], ['FAQs', '/faqs/']];
const cur = (h: string) => (here === h ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="imageto20kb" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#4F46E5" />
  <script is:inline>try{var t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t;else if(matchMedia('(prefers-color-scheme: dark)').matches)document.documentElement.dataset.theme='dark'}catch(e){}</script>
  <meta name="msvalidate.01" content={BING_VALIDATION} />
  <Seo {...seo} />
  {import.meta.env.PROD && (<>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${GA_ID}');`}></script>
  </>)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap bar">
      <a class="logo" href="/"><img class="logo-img" src="/favicon-96x96.png" width="32" height="32" alt="" />{SITE_NAME}</a>
      <nav id="nav" aria-label="Main">
        <span class="nav-title" aria-hidden="true">Menu</span>
        <button class="icon-btn nav-close" id="nav-close" type="button" aria-label="Close menu">✕</button>
        {top.map(([n, h]) => <a href={h} aria-current={cur(h)}>{n}</a>)}
        <div class="dd">
          <button type="button" class:list={['dd-btn', { active: toolPaths.has(here) }]} id="tools-btn" aria-expanded="false" aria-controls="tools-menu">Tools <span class="chev" aria-hidden="true">▾</span></button>
          <div class="dd-panel" id="tools-menu">
            {toolGroups.map((g) => (<div><h3>{g.title}</h3>{g.links.map(([n, h]) => <a href={h} aria-current={cur(h)}>{n}</a>)}</div>))}
          </div>
        </div>
        {top2.map(([n, h]) => <a href={h} aria-current={cur(h)}>{n}</a>)}
        <a class="nav-cta" href="/compress-image-to-20kb/">Compress to 20KB</a>
      </nav>
      <div class="actions">
        <button class="icon-btn" id="theme-btn" type="button" aria-label="Toggle dark mode">◐</button>
        <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="nav" aria-label="Open menu">☰</button>
      </div>
    </div>
  </header>
  <div class="overlay" id="overlay" aria-hidden="true"></div>
  <main id="main">
    {crumbs && <nav class="wrap crumbs" aria-label="Breadcrumb"><a href="/">Home</a>{crumbs.map((c) => <><span aria-hidden="true"> › </span><a href={c.href}>{c.name}</a></>)}</nav>}
    <slot />
  </main>
  <footer class="site-footer"><div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="logo" href="/"><img class="logo-img" src="/favicon-96x96.png" width="34" height="34" alt="" loading="lazy" />{SITE_NAME}</a>
        <p>Compress photos and signatures to the KB size your form asks for, right in your browser.</p>
      </div>
      {footer.map((sec) => (
        <nav aria-labelledby={`f-${sec.title.replace(/\s/g, '')}`}>
          <h2 id={`f-${sec.title.replace(/\s/g, '')}`}>{sec.title}</h2>
          <ul>{sec.links.map(([n, h]) => <li><a href={h}>{n}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="foot-bottom">© {new Date().getFullYear()} {SITE_NAME}. All rights reserved.</div>
  </div></footer>
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var themeBtn = document.getElementById('theme-btn');
      if (themeBtn) themeBtn.addEventListener('click', function () {
        var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
      var mb = document.getElementById('menu-btn'), nav = document.getElementById('nav'),
          ov = document.getElementById('overlay'), cb = document.getElementById('nav-close');
      if (!mb || !nav || !ov) return;
      var tb = document.getElementById('tools-btn'), tp = document.getElementById('tools-menu');
      function setTools(o) { if (!tb || !tp) return; tp.classList.toggle('open', o); tb.setAttribute('aria-expanded', String(o)); }
      if (tb && tp) {
        tb.addEventListener('click', function () { setTools(!tp.classList.contains('open')); });
        document.addEventListener('click', function (e) { if (!tb.contains(e.target) && !tp.contains(e.target)) setTools(false); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && tp.classList.contains('open') && !nav.classList.contains('open')) { setTools(false); tb.focus(); } });
      }
      function isOpen() { return nav.classList.contains('open'); }
      function setOpen(open, restoreFocus) {
        nav.classList.toggle('open', open);
        ov.classList.toggle('show', open);
        document.body.classList.toggle('menu-open', open);
        mb.setAttribute('aria-expanded', String(open));
        if (!open) setTools(false);
        mb.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        if (open && cb) cb.focus();
        else if (restoreFocus) mb.focus();
      }
      mb.addEventListener('click', function () { setOpen(!isOpen(), true); });
      if (cb) cb.addEventListener('click', function () { setOpen(false, true); });
      ov.addEventListener('click', function () { setOpen(false, true); });
      nav.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('a')) setOpen(false, false); });
      document.addEventListener('keydown', function (e) {
        if (!isOpen()) return;
        if (e.key === 'Escape') { setOpen(false, true); return; }
        if (e.key === 'Tab') {
          var f = Array.prototype.slice.call(nav.querySelectorAll('a,button')).filter(function (x) { return x.offsetParent !== null; });
          if (!f.length) return;
          var first = f[0], last = f[f.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      });
      var mq = window.matchMedia('(max-width: 960px)');
      var onChange = function (e) { if (!e.matches && isOpen()) setOpen(false, false); };
      if (mq.addEventListener) mq.addEventListener('change', onChange); else mq.addListener(onChange);
      window.addEventListener('pageshow', function () { setOpen(false, false); }); // e.g. back button / bfcache
    })();
  </script>
</body>
</html>
