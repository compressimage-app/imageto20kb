---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { SITE_NAME, CONTACT_EMAIL } from '../config';
interface Props { title: string; description: string; path: string; noindex?: boolean; jsonld?: object[]; crumbs?: { name: string; href: string }[] }
const { crumbs, ...seo } = Astro.props;
const nav = [
  ['Image Compressor', '/image-compressor/'], ['Compress to 20KB', '/compress-image-to-20kb/'], ['Compress to 100KB', '/compress-image-to-100kb/'],
  ['Image Resizer', '/image-resizer/'], ['FAQs', '/faqs/'], ['How It Works', '/how-it-works/'],
];
const foot = [['About', '/about/'], ['Contact', '/contact/'], ['Privacy Policy', '/privacy-policy/'], ['Terms and Conditions', '/terms-and-conditions/'], ['Cookie Policy', '/cookie-policy/'], ['Disclaimer', '/disclaimer/'], ['Security', '/security/'], ['Accessibility', '/accessibility/'], ['Copyright Policy', '/copyright-policy/']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="imageto20kb" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#4F46E5" />
  <script is:inline>try{var t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t;else if(matchMedia('(prefers-color-scheme: dark)').matches)document.documentElement.dataset.theme='dark'}catch(e){}</script>
  <Seo {...seo} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap bar">
      <a class="logo" href="/"><span class="logo-mark" aria-hidden="true"></span>{SITE_NAME}</a>
      <nav id="nav" aria-label="Main">
        <span class="nav-title" aria-hidden="true">Menu</span>
        <button class="icon-btn nav-close" id="nav-close" type="button" aria-label="Close menu">✕</button>
        {nav.map(([n, h]) => <a href={h} aria-current={Astro.url.pathname === h ? 'page' : undefined}>{n}</a>)}
        <a class="nav-cta" href="/compress-image-to-20kb/">Compress to 20KB</a>
      </nav>
      <div class="actions">
        <button class="icon-btn" id="theme-btn" type="button" aria-label="Toggle dark mode">◐</button>
        <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="nav" aria-label="Open menu">☰</button>
      </div>
    </div>
  </header>
  <div class="overlay" id="overlay" aria-hidden="true"></div>
  <main id="main">
    {crumbs && <nav class="wrap crumbs" aria-label="Breadcrumb"><a href="/">Home</a>{crumbs.map((c) => <><span aria-hidden="true"> › </span><a href={c.href}>{c.name}</a></>)}</nav>}
    <slot />
  </main>
  <footer class="site-footer"><div class="wrap">
    <p><strong>{SITE_NAME}</strong>: image compression that runs in your browser.</p>
    <nav aria-label="Footer">{foot.map(([n, h]) => <a href={h}>{n}</a>)}</nav>
    <p class="muted">1 KB = 1,024 bytes. © {new Date().getFullYear()} {SITE_NAME}</p>
  </div></footer>
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var themeBtn = document.getElementById('theme-btn');
      if (themeBtn) themeBtn.addEventListener('click', function () {
        var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
      var mb = document.getElementById('menu-btn'), nav = document.getElementById('nav'),
          ov = document.getElementById('overlay'), cb = document.getElementById('nav-close');
      if (!mb || !nav || !ov) return;
      function isOpen() { return nav.classList.contains('open'); }
      function setOpen(open, restoreFocus) {
        nav.classList.toggle('open', open);
        ov.classList.toggle('show', open);
        document.body.classList.toggle('menu-open', open);
        mb.setAttribute('aria-expanded', String(open));
        mb.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        if (open && cb) cb.focus();
        else if (restoreFocus) mb.focus();
      }
      mb.addEventListener('click', function () { setOpen(!isOpen(), true); });
      if (cb) cb.addEventListener('click', function () { setOpen(false, true); });
      ov.addEventListener('click', function () { setOpen(false, true); });
      nav.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('a')) setOpen(false, false); });
      document.addEventListener('keydown', function (e) {
        if (!isOpen()) return;
        if (e.key === 'Escape') { setOpen(false, true); return; }
        if (e.key === 'Tab') {
          var f = Array.prototype.slice.call(nav.querySelectorAll('a,button')).filter(function (x) { return x.offsetParent !== null; });
          if (!f.length) return;
          var first = f[0], last = f[f.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      });
      var mq = window.matchMedia('(max-width: 980px)');
      var onChange = function (e) { if (!e.matches && isOpen()) setOpen(false, false); };
      if (mq.addEventListener) mq.addEventListener('change', onChange); else mq.addListener(onChange);
      window.addEventListener('pageshow', function () { setOpen(false, false); }); // e.g. back button / bfcache
    })();
  </script>
</body>
</html>
