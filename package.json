{
  "name": "imageto20kb",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/chunk-paragraphs.mjs && node scripts/minify-inline.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "check:seo": "node scripts/check-seo.mjs",
    "report:keywords": "node scripts/keyword-report.mjs",
    "audit:render": "node scripts/audit-render-blocking.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "verify": "npm run build && npm test && npm run check:seo && npm run audit:render && npm run audit:perf",
    "deploy": "npm run build && wrangler deploy",
    "audit:perf": "node scripts/perf-budget.mjs",
    "audit:browser": "node scripts/browser-audit.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}